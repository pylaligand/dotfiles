[alias]
    br = "branch"
    can = "commit --amend --no-edit"
    cmp = "!git checkout main && git pull --rebase"
    lo = "log --oneline --decorate"
    nb = "!git fetch origin && git checkout -b $1 origin/main #"
    po = "push origin HEAD"
    pof = "push origin HEAD --force-with-lease"
    pr = "pull --rebase"
    pri = "pull --rebase=interactive"
    rh = "reset --hard"
    st = "show HEAD --stat --format=''"
    stu = "diff HEAD --stat"
    up = "branch --set-upstream-to=origin/main"

# Route github.com auth through gh so a single token (GH_TOKEN) serves both gh
# and git. The empty `helper` resets the inherited list, clearing any existing
# helper. `!gh` is resolved via PATH for portability across machines.
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[rebase]
    autoStash = true

[user]
    name = P.Y. Laligand
    email = py.laligand@gmail.com
